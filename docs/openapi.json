            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/ingest/commit": {
      "post": {
        "operationId": "ingest_commit_ingest_commit_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-ingest-token",
            "required": false,
            "schema": {
              "anyOf": [
                {
