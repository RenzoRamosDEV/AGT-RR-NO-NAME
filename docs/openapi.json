            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IngestCommitRequest": {
        "additionalProperties": false,
        "properties": {
          "author": {
            "default": "",
            "title": "Author",
            "type": "string"
          },
          "diff": {
            "default": "",
            "title": "Diff",
            "type": "string"
          },
          "head_sha": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Head Sha",
            "type": "string"
          },
          "project": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Project",
            "type": "string"
          },
          "ref": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Ref",
            "type": "string"
          },
          "title": {
            "default": "",
            "title": "Title",
            "type": "string"
          },
          "url": {
            "default": "",
            "maxLength": 1000,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "project",
          "ref",
          "head_sha"
        ],
        "title": "IngestCommitRequest",
        "type": "object"
      },
      "IngestCommitResponse": {
        "properties": {
          "change_id": {
            "format": "uuid",
